{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mission Control",
  "version": "0.1.0",
  "identifier": "com.missioncontrol.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build:spa",
    "frontendDist": "../dist/client"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mission Control",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png"],
    "publisher": "Mission Control",
    "copyright": "Copyright © 2025 Mission Control",
    "shortDescription": "A personal operating system for focused, disciplined days.",
    "longDescription": "Mission Control is a luxury Windows desktop application for tracking focus sessions, missions, training, and journaling — all offline, all yours.",
    "homepage": "https://github.com/AMZSACDbdh/mission_control",
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsi",
        "installMode": "currentUser",
        "startMenuFolder": "Mission Control",
        "shortcutName": "Mission Control",
        "createDesktopShortcut": "Always"
      }
    }
  },
  "plugins": {
    "store": {}
  }
}
